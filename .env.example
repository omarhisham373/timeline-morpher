# Everything is optional. With nothing set, the app uses the browser's Web Speech
# API (or the bundled transcript) and the deterministic on-device parser.

# ── LLM parser (any OpenAI-compatible chat endpoint) ─────────────────────────
# Presets: openai | gemini | groq | openrouter | ollama   (sets base URL + default model)
# Free options: gemini (AI Studio free tier), groq (free tier), ollama (local, no key).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Override for any other OpenAI-compatible server (vLLM, LM Studio, Together…)
LLM_BASE_URL=
# Defaults: 15000 ms for hosted providers, 90000 ms for keyless/local ones.
LLM_TIMEOUT_MS=

# ── Server-side speech-to-text for recordings without live captions ─────────
# Presets: openai | groq | whisper-local (free, on-device: scripts/local-whisper-server.py)
# Any Whisper-compatible /audio/transcriptions endpoint. Falls back to LLM_API_KEY.
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=
STT_BASE_URL=
